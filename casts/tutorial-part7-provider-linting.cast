{"version": 2, "width": 120, "height": 40, "timestamp": 1790102575, "title": "Part 7 \u2014 author and verify a provider lint rule", "env": {"TERM": "xterm-256color", "SHELL": "/bin/bash"}}
[0.5, "o", "Part 7: author and verify one provider lint rule.\r\n"]
[0.535, "o", "Every command below is runnable from this checked-in tutorial directory.\r\n"]
[0.569, "o", "\r\n"]
[0.604, "o", "\u001b[1;36m$ uv sync --frozen\u001b[0m\r\n"]
[0.639, "o", "\r\n"]
[0.674, "o", "\u001b[1;36m$ uv run pytest tests/test_linting.py -q\u001b[0m\r\n"]
[0.896, "o", "\u001b[32m.\u001b[0m"]
[0.931, "o", "\u001b[32m.\u001b[0m"]
[0.966, "o", "\u001b[32m.\u001b[0m"]
[1.0, "o", "\u001b[32m.\u001b[0m"]
[1.035, "o", "\u001b[32m.\u001b[0m"]
[1.07, "o", "\u001b[32m.\u001b[0m"]
[1.104, "o", "\u001b[32m.\u001b[0m"]
[1.139, "o", "\u001b[32m.\u001b[0m"]
[1.174, "o", "\u001b[32m.\u001b[0m"]
[1.209, "o", "\u001b[32m                                                                                                        [100%]\u001b[0m"]
[1.243, "o", "\r\n"]
[1.278, "o", "\u001b[32m\u001b[32m\u001b[1m9 passed\u001b[0m\u001b[32m in 0.39s\u001b[0m\u001b[0m\r\n"]
[1.313, "o", "\r\n"]
[1.347, "o", "\u001b[1;36m$ uv run flavor pack --quiet --manifest pyproject.toml\u001b[0m\r\n"]
[31.256, "o", "Built and verified dist/terraform-provider-mycloud.psp\r\n"]
[31.291, "o", "\r\n"]
[31.325, "o", "\u001b[1;36m$ install -m 755 dist/terraform-provider-mycloud.psp dist/terraform-provider-mycloud\u001b[0m\r\n"]
[31.36, "o", "\r\n"]
[31.395, "o", "\u001b[1;36m$ uvx --from tofusoup==0.8.2 soup lint lint.soup.toml --provider \"$PWD/dist/terraform-provider-mycloud\" --lane direct\u001b[0m\r\n"]
[33.995, "o", "Direct provider validation: 1/1 cases\r\n"]
[34.03, "o", "  warning: resource mycloud_server: Production environment is encoded in the server name (example/mycloud:production-name)\r\n"]
[34.064, "o", "OpenTofu experimental lint validation: not requested\r\n"]
[34.099, "o", "OpenTofu coverage is separate from direct provider coverage.\r\n"]
[34.134, "o", "\r\n"]
[34.168, "o", "\u001b[1;36m$ ./install-opentofu.sh 1.13.0-rc1\u001b[0m\r\n"]
[34.384, "o", "tofu_1.13.0-rc1_linux_amd64.zip: OK\r\n"]
[34.883, "o", "Installed OpenTofu 1.13.0-rc1 (verified official SHA-256)\r\n"]
[34.918, "o", "\r\n"]
[34.952, "o", "\u001b[1;36m$ opentofu_rc1=\"$PWD/.cache/opentofu/1.13.0-rc1/tofu\"\u001b[0m\r\n"]
[34.987, "o", "\r\n"]
[35.022, "o", "\u001b[1;36m$ \"$opentofu_rc1\" version\u001b[0m\r\n"]
[35.056, "o", "OpenTofu v1.13.0-rc1\r\n"]
[35.091, "o", "on linux_amd64\r\n"]
[35.126, "o", "\r\n"]
[35.161, "o", "\u001b[1;36m$ uvx --from tofusoup==0.8.2 soup lint lint.soup.toml --provider \"$PWD/dist/terraform-provider-mycloud\" --opentofu \"$opentofu_rc1\" --lane opentofu\u001b[0m\r\n"]
[36.278, "o", "Direct provider validation: not requested\r\n"]
[36.313, "o", "OpenTofu experimental lint validation: valid\r\n"]
[36.347, "o", "  warning: Experimental linting enabled\r\n"]
[36.382, "o", "  warning: Production environment is encoded in the server name (example/mycloud:production-name)\r\n"]
[36.417, "o", "OpenTofu coverage is separate from direct provider coverage.\r\n"]
